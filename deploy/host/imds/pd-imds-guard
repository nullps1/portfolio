#!/bin/bash
# Keeps exactly three rules in Docker's DOCKER-USER chain that stop containers from reaching the OCI instance
# metadata service (169.254.169.254) while DNS to that address (udp/tcp 53) keeps working. The rules are the
# ones that passed the supervised test; this script never flushes a chain, never restores a snapshot and never
# touches any rule that is not one of the three.
#
#   apply         idempotent: no-op when the rules are already correct, otherwise repairs only these rules
#   verify        read-only: exit 0 only when the three rules are present exactly once, DNS before REJECT
#   verify --live verify, and additionally require the FORWARD -> DOCKER-USER jump (Docker is running)
#   remove        the rollback: deletes only these three rules, REJECT first
#   status        prints the chain
set -u
export LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

readonly CHAIN="DOCKER-USER"
readonly META="169.254.169.254"
readonly TAG="pd-imds-guard"
# Order matters: the DNS exceptions (0, 1) precede the metadata rejection (2).
readonly -a RULES=(
  "-d ${META}/32 -p udp --dport 53 -m comment --comment ${TAG} -j RETURN"
  "-d ${META}/32 -p tcp --dport 53 -m comment --comment ${TAG} -j RETURN"
  "-d ${META}/32 -m comment --comment ${TAG} -j REJECT --reject-with icmp-port-unreachable"
)
readonly LOCK="${PD_IMDS_LOCK:-/run/pd-imds-guard.lock}"

log() { echo "pd-imds-guard: $*" >&2; }
ipt() { iptables -w 5 "$@"; }

# rule_state INDEX -> 0 present, 1 absent, 2 cannot tell
rule_state() {
  local -a spec
  IFS=' ' read -ra spec <<<"${RULES[$1]}"
  ipt -C "$CHAIN" "${spec[@]}" 2>/dev/null
  case "$?" in 0) return 0 ;; 1) return 1 ;; *) return 2 ;; esac
}

# Deletes every copy of rule INDEX (matched in full, never by position).
delete_rule() {
  local -a spec
  local n=0
  IFS=' ' read -ra spec <<<"${RULES[$1]}"
  while [ "$n" -lt 10 ]; do
    rule_state "$1"
    case "$?" in
      0) ipt -D "$CHAIN" "${spec[@]}" || return 1 ;;
      1) return 0 ;;
      *) return 1 ;;
    esac
    n=$((n + 1))
  done
  return 1
}

chain_exists() { ipt -S "$CHAIN" >/dev/null 2>&1; }

# verify_rules: 0 only when all three are present, exactly three carry our tag, and the order is RETURN, RETURN, REJECT.
verify_rules() {
  local i st out
  local -a mine
  chain_exists || {
    log "chain ${CHAIN} does not exist"
    return 1
  }
  for i in 0 1 2; do
    rule_state "$i"
    st=$?
    [ "$st" -eq 0 ] || {
      log "rule $((i + 1)) missing or unreadable (state ${st})"
      return 1
    }
  done
  out="$(ipt -S "$CHAIN")" || return 1
  # The three rules must be the first three rules of the chain, so no earlier ACCEPT/RETURN can shadow them.
  mapfile -t mine < <(grep '^-A ' <<<"$out" | head -n 3)
  [ "${#mine[@]}" -eq 3 ] || {
    log "chain has fewer than 3 rules"
    return 1
  }
  [[ ${mine[0]} == *"--comment ${TAG}"* && ${mine[1]} == *"--comment ${TAG}"* && ${mine[2]} == *"--comment ${TAG}"* ]] || {
    log "the first three rules of ${CHAIN} are not ours (shadowed or out of place)"
    return 1
  }
  [ "$(grep -cF -- "--comment ${TAG}" <<<"$out")" -eq 3 ] || {
    log "expected exactly 3 rules tagged ${TAG}"
    return 1
  }
  [[ ${mine[0]} == *" -j RETURN" && ${mine[1]} == *" -j RETURN" ]] || {
    log "DNS exceptions do not come first"
    return 1
  }
  [[ ${mine[2]} == *" -j REJECT "* ]] || {
    log "REJECT is not after the DNS exceptions"
    return 1
  }
  [[ ${mine[0]}${mine[1]} == *"-p udp"* && ${mine[0]}${mine[1]} == *"-p tcp"* ]] || {
    log "DNS exceptions must cover udp and tcp"
    return 1
  }
  return 0
}

do_apply() {
  local i j
  local -a spec
  if ! chain_exists; then
    ipt -N "$CHAIN" 2>/dev/null || true # Docker may have created it in the meantime
    chain_exists || {
      log "cannot create ${CHAIN}"
      return 1
    }
  fi
  if verify_rules 2>/dev/null; then
    log "rules already in place; nothing changed"
    return 0
  fi
  # Repair: the REJECT is removed first so a DNS exception is never missing while it still exists, then
  # the three rules are inserted at positions 1-3 in the tested order (on an empty chain that is identical to
  # appending). Only on this repair path can metadata be reachable for a few milliseconds.
  for i in 2 1 0; do delete_rule "$i" || {
    log "cannot clear rule $((i + 1))"
    return 1
  }; done
  for i in 0 1 2; do
    IFS=' ' read -ra spec <<<"${RULES[$i]}"
    ipt -I "$CHAIN" "$((i + 1))" "${spec[@]}" || {
      log "cannot insert rule $((i + 1)); rolling back this run"
      for j in 2 1 0; do delete_rule "$j"; done
      return 1
    }
  done
  verify_rules || return 1
  log "rules installed"
}

do_remove() {
  local i st rc=0
  chain_exists || {
    log "chain ${CHAIN} does not exist; nothing to remove"
    return 0
  }
  for i in 2 1 0; do delete_rule "$i" || rc=1; done
  for i in 0 1 2; do
    rule_state "$i"
    st=$?
    [ "$st" -eq 1 ] || {
      log "rule $((i + 1)) still present or unreadable"
      rc=1
    }
  done
  [ "$rc" -eq 0 ] && log "rules removed"
  return "$rc"
}

do_verify() {
  verify_rules || return 1
  if [ "${1:-}" = "--live" ]; then
    local fwd
    fwd="$(ipt -S FORWARD 2>/dev/null | grep '^-A ' | head -n 1)"
    [[ $fwd == "-A FORWARD -j ${CHAIN}" ]] || {
      log "the first FORWARD rule is not the jump to ${CHAIN}"
      return 1
    }
    [ "$(ipt -S FORWARD | grep -c -- "-j ${CHAIN}\$")" -eq 1 ] || {
      log "FORWARD must jump to ${CHAIN} exactly once"
      return 1
    }
  fi
  log "verified"
}

cmd="${1:-}"
case "$cmd" in
  apply | remove | verify | status) ;;
  *)
    echo "usage: pd-imds-guard apply | verify [--live] | remove | status" >&2
    exit 2
    ;;
esac
[ "$cmd" = status ] && {
  ipt -S "$CHAIN"
  exit $?
}
[ "$(id -u)" -eq 0 ] || {
  log "run as root"
  exit 1
}
# Serialise writers (the boot unit, the timer, a manual run, the rollback) so two runs never interleave;
# verify takes a shared lock so it never reports a half-finished repair.
exec 9>"$LOCK" || exit 1
if [ "$cmd" = verify ]; then lockopt=-s; else lockopt=-x; fi
flock "$lockopt" -w 30 9 || {
  log "lock timeout"
  exit 1
}
case "$cmd" in
  apply) do_apply ;;
  remove) do_remove ;;
  verify) do_verify "${2:-}" ;;
esac
